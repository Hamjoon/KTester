  {
    "group": "getDriverSpec - Driver volumes and volume mounts",
    "cases": [
      {
        "input": [
          {
            "parameter": "request",
            "value": {
              "driver": {
                "volumeMounts": [
                  "mount1"
                ]
              },
              "volumes": [
                "volume1"
              ]
            }
          },
          {
            "parameter": "appConfig",
            "value": {}
          },
          {
            "parameter": "parentQueue",
            "value": "testQueue"
          },
          {
            "parameter": "sparkCluster",
            "value": {
              "driver": {
                "volumeMounts": [
                  "mount2"
                ]
              }
            }
          }
        ],
        "expected": {
          "volumeMounts": [
            "mount1"
          ]
        },
        "description": "Test case where driver volumes in request have higher priority than sparkCluster."
      },
      {
        "input": [
          {
            "parameter": "request",
            "value": {
              "driver": null,
              "volumes": [
                "volume1"
              ]
            }
          },
          {
            "parameter": "appConfig",
            "value": {}
          },
          {
            "parameter": "parentQueue",
            "value": "testQueue"
          },
          {
            "parameter": "sparkCluster",
            "value": {
              "driver": {
                "volumeMounts": [
                  "mount2"
                ]
              }
            }
          }
        ],
        "expected": {
          "volumeMounts": [
            "mount2"
          ]
        },
        "description": "Test case where sparkCluster volumes are used when driver is null."
      }
    ]
  },
