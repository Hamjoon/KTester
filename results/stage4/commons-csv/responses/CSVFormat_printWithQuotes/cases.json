[
  {
    "group": "printWithQuotes - QuoteMode.ALL",
    "cases": [
      {
        "input": [
          {
            "parameter": "object",
            "value": "null"
          },
          {
            "parameter": "charSeq",
            "value": "\"value\""
          },
          {
            "parameter": "out",
            "value": "new StringWriter()"
          },
          {
            "parameter": "newRecord",
            "value": "true"
          }
        ],
        "expected": "\"value\"",
        "description": "Test when QuoteMode is ALL; should always quote the value."
      }
    ]
  },
  {
