[
  {
    "group": "findRangePattern - Basic Functionality",
    "cases": [
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2,
                3
              ],
              "top": [
                1,
                2,
                4
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a basic range where the bottom and top patterns are within a valid range."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2,
                3
              ],
              "top": [
                1,
                2,
                3
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where the bottom and top patterns are equal."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2,
                4
              ],
              "top": [
                1,
                2,
                5
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where the bottom is less than the top by one unit in the last element."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                0,
                1
              ],
              "top": [
                0,
                2
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where the bottom is less than the top with an open range at the top."
      }
    ]
  },
  {
    "group": "findRangePattern - Edge Cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2,
                3
              ],
              "top": [
                1,
                2,
                2
              ],
              "openBottom": false,
              "openTop": true
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where the top is strictly less than the bottom."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                0,
                0,
                0
              ],
              "top": [
                0,
                0,
                0
              ],
              "openBottom": false,
              "openTop": true
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where all values are the same but the top is open."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2,
                3
              ],
              "top": [
                1,
                3,
                2
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "null",
        "description": "Tests a range where the top pattern is not in a valid order compared to the bottom."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1
              ],
              "top": [
                2
              ],
              "openBottom": true,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests a range where the bottom is open and the top is closed."
      }
    ]
  },
  {
    "group": "findRangePattern - Null and Invalid Inputs",
    "cases": [
      {
        "input": [
          {
            "parameter": "range",
            "value": null
          }
        ],
        "expected": "null",
        "description": "Tests the behavior when the input range is null."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                1,
                2
              ],
              "top": [
                1
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "null",
        "description": "Tests a range where the bottom is longer than the top, which is invalid."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [],
              "top": [],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "null",
        "description": "Tests a range where both bottom and top are empty arrays."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                5
              ],
              "top": [
                3
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "null",
        "description": "Tests a range where the bottom is greater than the top."
      }
    ]
  },
  {
    "group": "findRangePattern - Boundary Conditions",
    "cases": [
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                0
              ],
              "top": [
                0
              ],
              "openBottom": true,
              "openTop": true
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests the boundary condition where both bottom and top are at the minimum possible values."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                127
              ],
              "top": [
                127
              ],
              "openBottom": false,
              "openTop": false
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests the boundary condition where both bottom and top are at the maximum byte value."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                0,
                0
              ],
              "top": [
                0,
                1
              ],
              "openBottom": false,
              "openTop": true
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests the boundary condition where the bottom is at the minimum possible value and the top is open."
      },
      {
        "input": [
          {
            "parameter": "range",
            "value": {
              "bottom": [
                126
              ],
              "top": [
                127
              ],
              "openBottom": false,
              "openTop": true
            }
          }
        ],
        "expected": "valid NameState object",
        "description": "Tests the boundary condition where the bottom is just below the maximum byte value and the top is open."
      }
    ]
  },
