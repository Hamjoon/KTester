[
  {
    "group": "equals method basic equality",
    "cases": [
      {
        "input": [
          {
            "parameter": "a",
            "value": "null"
          },
          {
            "parameter": "b",
            "value": "null"
          }
        ],
        "expected": true,
        "description": "Test that equals returns true when both parameters are null."
      },
      {
        "input": [
          {
            "parameter": "a",
            "value": "String.class"
          },
          {
            "parameter": "b",
            "value": "String.class"
          }
        ],
        "expected": true,
        "description": "Test that equals returns true when both parameters are the same class."
      }
    ]
  },
  {
    "group": "equals method class comparison",
    "cases": [
      {
        "input": [
          {
            "parameter": "a",
            "value": "String.class"
          },
          {
            "parameter": "b",
            "value": "Integer.class"
          }
        ],
        "expected": false,
        "description": "Test that equals returns false when comparing different classes."
      },
      {
        "input": [
          {
            "parameter": "a",
            "value": "String.class"
          },
          {
            "parameter": "b",
            "value": "String.class"
          }
        ],
        "expected": true,
        "description": "Test that equals returns true when comparing the same class."
      }
    ]
  },
  {
