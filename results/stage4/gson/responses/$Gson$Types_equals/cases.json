          },
          {
            "parameter": "b",
            "value": "new ParameterizedTypeImpl(List.class, String.class)"
          }
        ],
        "expected": true,
        "description": "Test that equals returns true when comparing parameterized types with the same actual type arguments."
      }
    ]
  },
