[
  {
    "group": "isAssignableFrom - Null Type",
    "cases": [
      {
        "input": [
          {
            "parameter": "from",
            "value": null
          },
          {
            "parameter": "to",
            "value": "SomeParameterizedType"
          },
          {
            "parameter": "typeVarMap",
            "value": "{}"
          }
        ],
        "expected": false,
        "description": "Test when 'from' is null. The method should return false."
      }
    ]
  },
  {
