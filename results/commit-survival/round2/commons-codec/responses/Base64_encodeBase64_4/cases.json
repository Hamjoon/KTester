[
  {
    "group": "Empty input handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "binaryData",
            "value": []
          },
          {
            "parameter": "isChunked",
            "value": false
          },
          {
            "parameter": "urlSafe",
            "value": false
          },
          {
            "parameter": "maxResultSize",
            "value": 10
          }
        ],
        "expected": "[]",
        "description": "When the input byte array is empty, the method should return the same empty array without invoking any other logic."
      }
    ]
  },
  {
    "group": "Standard encoding without chunking",
    "cases": [
      {
        "input": [
          {
            "parameter": "binaryData",
            "value": [
              97,
              110,
              121
            ]
          },
          {
            "parameter": "isChunked",
            "value": false
          },
          {
            "parameter": "urlSafe",
            "value": false
          },
          {
            "parameter": "maxResultSize",
            "value": 10
          }
        ],
        "expected": "YW55",
        "description": "Encode a short ASCII payload without chunking or URL\u2011safe mode; the result should be the standard Base64 string \"YW55\"."
      }
    ]
  },
  {
    "group": "Chunked encoding with line separators",
    "cases": [
      {
        "input": [
          {
            "parameter": "binaryData",
            "value": [
              97,
