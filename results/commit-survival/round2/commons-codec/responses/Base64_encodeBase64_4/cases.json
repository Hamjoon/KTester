            "parameter": "maxResultSize",
            "value": 0
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "A maxResultSize of zero cannot accommodate any encoded output; the method must throw IllegalArgumentException for any non\u2011empty binaryData."
      }
    ]
  },
