        "description": "A newline character is not part of the allowed salt character set."
      }
    ]
  },
  {
    "group": "Invalid arguments - salt contains tab character",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"\\t\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
