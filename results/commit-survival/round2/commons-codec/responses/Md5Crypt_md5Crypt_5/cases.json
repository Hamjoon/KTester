[
  {
    "group": "Valid inputs - standard MD5 prefix",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the provided salt \"mysalt\" (e.g., \"$1$mysalt$...$\")",
        "description": "Verifies that a normal password and a simple salt produce a correctly formatted MD5\u2011crypt hash with the \"$1$\" prefix."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'s','e','c','r','e','t'}"
          },
          {
            "parameter": "salt",
            "value": "\"abc123\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
        ],
        "expected": "String that starts with \"$apr1$\" and contains the provided salt \"abc123\" (e.g., \"$apr1$abc123$...$\")",
        "description": "Ensures that using the APR\u20111 prefix yields a hash that begins with \"$apr1$\" while preserving the supplied salt."
      }
    ]
  },
  {
    "group": "Valid inputs - salt already contains prefix",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'t','e','s','t'}"
          },
          {
            "parameter": "salt",
            "value": "\"$1$alreadyPrefixed\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the salt without a duplicated prefix (e.g., \"$1$alreadyPrefixed$...$\")",
        "description": "Checks that when the supplied salt already includes the MD5 prefix, the method does not prepend the prefix a second time."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'t','e','s','t'}"
          },
          {
            "parameter": "salt",
            "value": "\"$apr1$alreadyPrefixed\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
        ],
        "expected": "String that starts with \"$apr1$\" and contains the salt without a duplicated prefix (e.g., \"$apr1$alreadyPrefixed$...$\")",
        "description": "Same as above but for the APR\u20111 prefix."
      }
    ]
  },
  {
    "group": "Invalid arguments - null or empty values",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "null"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The method must reject a null password byte array."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "null"
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The method must reject a null salt string."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The method must reject a null prefix."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "An empty salt is not allowed; the method should throw an exception."
      }
    ]
  },
  {
    "group": "Invalid arguments - unsupported prefix",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "\"$unknown$\""
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Only the two known prefixes (\"$1$\" and \"$apr1$\") are supported; any other prefix should cause an exception."
      }
    ]
  },
  {
    "group": "Invalid arguments - salt length limits",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"1234567890123456\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The implementation limits the salt to a maximum of 8 characters; a longer salt must trigger an exception."
      }
    ]
  },
  {
    "group": "Boundary conditions - salt length limits",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"12345678\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the salt \"12345678\" (e.g., \"$1$12345678$...$\")",
        "description": "Salt length exactly 8 characters is the maximum allowed; the method should accept it and produce a correctly formatted hash."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"a\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
        ],
        "expected": "String that starts with \"$apr1$\" and contains the salt \"a\" (e.g., \"$apr1$a$...$\")",
        "description": "Salt length of 1 character is the minimum allowed; the method should accept it and produce a correctly formatted hash."
      }
    ]
  },
  {
    "group": "Salt character set validation - allowed characters",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"a./B9_\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the salt \"a./B9_\" (e.g., \"$1$a./B9_$...$\")",
        "description": "The salt contains only characters permitted by the MD5\u2011crypt specification (letters, digits, '.' and '/'); the method should accept it."
      }
    ]
  },
  {
    "group": "Salt character set validation - disallowed characters",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"bad$char\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The salt contains a '$' character that is not part of a leading prefix; the method must reject it."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"space char\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The salt contains a space character, which is not allowed; the method must throw an exception."
      }
    ]
  },
  {
    "group": "Password edge cases - empty and large byte arrays",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{}"
          },
          {
            "parameter": "salt",
            "value": "\"emptysalt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the salt \"emptysalt\" (e.g., \"$1$emptysalt$...$\")",
        "description": "An empty password byte array is technically allowed; the method should still produce a valid hash."
      },
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[1024]"
          },
          {
            "parameter": "salt",
            "value": "\"bigSalt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.APR1_PREFIX"
          }
        ],
        "expected": "String that starts with \"$apr1$\" and contains the salt \"bigSalt\" (e.g., \"$apr1$bigSalt$...$\")",
        "description": "A large password (1\u202fKB) should be processed without error and produce a correctly formatted hash."
      }
    ]
  },
  {
    "group": "Password with non\u2011ASCII characters (UTF\u20118 bytes)",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "\"p\u00e4ssw\u00f6rd\".getBytes(StandardCharsets.UTF_8)"
          },
          {
            "parameter": "salt",
            "value": "\"utf8salt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "String that starts with \"$1$\" and contains the salt \"utf8salt\" (e.g., \"$1$utf8salt$...$\")",
        "description": "Password bytes contain Unicode characters; the method should treat the raw bytes and still return a valid hash."
      }
    ]
  },
  {
    "group": "Deterministic output for identical inputs",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"repeatSalt\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "Two consecutive calls with the same arguments return exactly the same string",
        "description": "Ensures that md5Crypt is pure (no hidden randomness) when a salt is supplied; the hash must be identical across invocations."
      }
    ]
  },
  {
    "group": "Invalid arguments - malformed prefix string",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "\" $1$ \""
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Prefix contains leading/trailing whitespace; only the exact constants \"$1$\" or \"$apr1$\" are accepted."
      }
    ]
  },
  {
    "group": "Invalid arguments - empty prefix string",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "\"\""
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "An empty prefix string is not a supported value; the method must reject it."
      }
    ]
  },
  {
    "group": "Invalid arguments - malformed prefix with extra characters",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "\"$1$extra\""
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Prefix contains extra characters beyond the exact constants; only \"$1$\" or \"$apr1$\" are allowed."
      }
    ]
  },
  {
    "group": "Invalid arguments - case\u2011sensitive prefix mismatch",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"mysalt\""
          },
          {
            "parameter": "prefix",
            "value": "\"$APR1$\""
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Prefix is case\u2011sensitive; \"$APR1$\" is not recognized as a valid constant."
      }
    ]
  },
  {
    "group": "Invalid arguments - salt becomes empty after stripping prefix",
    "cases": [
      {
        "input": [
          {
            "parameter": "keyBytes",
            "value": "new byte[]{'p','a','s','s'}"
          },
          {
            "parameter": "salt",
            "value": "\"$1$\""
          },
          {
            "parameter": "prefix",
            "value": "Md5Crypt.MD5_PREFIX"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "When the supplied salt consists only of the prefix, stripping it leaves an empty salt, which is illegal."
      }
    ]
  },
  {
