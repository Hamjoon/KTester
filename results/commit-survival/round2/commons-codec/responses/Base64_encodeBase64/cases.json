  {
    "group": "Immutability and Reference Checks",
    "cases": [
      {
        "input": [
          {
            "parameter": "binaryData",
            "value": [
              97,
              98,
              99
            ],
            "note": "original array will be mutated after encoding"
          }
        ],
        "expected": {
          "outputUnchangedAfterInputMutation": true,
          "differentInstance": true
        },
        "description": "After calling encodeBase64, mutate the original array (e.g., change 97\u21920). The returned byte array must remain equal to the encoding of the original data and must not be the same object as the input."
