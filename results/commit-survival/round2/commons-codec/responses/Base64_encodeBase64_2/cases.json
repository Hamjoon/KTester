      {
        "input": [
          {
            "parameter": "binaryData",
            "value": [
              1,
              2,
              3,
              4
            ]
          },
          {
            "parameter": "isChunked",
            "value": false
          }
        ],
        "expected": "AQIDBA==",
        "description": "Four bytes produce one full Base64 quartet (AQID) and a second quartet with padding (BA==)."
      }
    ]
  },
