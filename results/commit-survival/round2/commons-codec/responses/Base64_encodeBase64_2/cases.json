      {
        "input": [
          {
            "parameter": "binaryData",
            "value": [
              0,
              1
            ]
          },
          {
            "parameter": "isChunked",
            "value": false
          }
        ],
        "expected": "AAE=",
        "description": "Two\u2011byte input must be padded with one '=' character."
