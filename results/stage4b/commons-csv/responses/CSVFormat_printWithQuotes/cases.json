            "parameter": "charSeq",
            "value": "\"Sample String\""
          },
          {
            "parameter": "out",
            "value": "StringWriter()"
          },
          {
            "parameter": "newRecord",
            "value": true
          }
        ],
        "expected": "\"Sample String\"",
        "description": "Test when QuoteMode is ALL, should always quote the output."
      }
    ]
  },
