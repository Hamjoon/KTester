  {
    "group": "createHeaders - valid header with no duplicates",
    "cases": [
      {
        "input": [
          {
            "parameter": "formatHeader",
            "value": [
              "header1",
              "header2",
              "header3"
            ]
          }
        ],
        "expected": {
          "headerMap": {
            "header1": 0,
            "header2": 1,
            "header3": 2
          },
          "headerNames": [
            "header1",
            "header2",
            "header3"
          ]
        },
        "description": "Test with a valid header that has no duplicates."
      }
    ]
  },
  {
