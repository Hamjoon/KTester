          {
            "parameter": "expression",
            "value": "#{company.name} is located at #{address.street} #{address.city}."
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": null
          },
          {
            "parameter": "context",
            "value": null
          }
        ],
        "expected": "Acme Corp is located at 123 Main St.",
