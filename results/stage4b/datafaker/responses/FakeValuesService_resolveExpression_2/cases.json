          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": null
          },
          {
            "parameter": "context",
            "value": null
          }
        ],
        "expected": "RuntimeException: Unable to resolve #{unknownDirective} directive for FakerContext null.",
