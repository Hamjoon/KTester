[
  {
    "group": "wrap method tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "type",
            "value": "int.class"
          }
        ],
        "expected": "Integer.class",
        "description": "Test case to verify that wrapping int.class returns Integer.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "float.class"
          }
        ],
        "expected": "Float.class",
        "description": "Test case to verify that wrapping float.class returns Float.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "byte.class"
          }
        ],
        "expected": "Byte.class",
        "description": "Test case to verify that wrapping byte.class returns Byte.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "double.class"
          }
        ],
        "expected": "Double.class",
        "description": "Test case to verify that wrapping double.class returns Double.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "long.class"
          }
        ],
        "expected": "Long.class",
        "description": "Test case to verify that wrapping long.class returns Long.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "char.class"
          }
        ],
        "expected": "Character.class",
        "description": "Test case to verify that wrapping char.class returns Character.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "boolean.class"
          }
        ],
        "expected": "Boolean.class",
        "description": "Test case to verify that wrapping boolean.class returns Boolean.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "short.class"
          }
        ],
        "expected": "Short.class",
        "description": "Test case to verify that wrapping short.class returns Short.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "void.class"
          }
        ],
        "expected": "Void.class",
        "description": "Test case to verify that wrapping void.class returns Void.class."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "String.class"
          }
        ],
        "expected": "String.class",
        "description": "Test case to verify that wrapping String.class returns String.class (non-primitive type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "Object.class"
          }
        ],
        "expected": "Object.class",
        "description": "Test case to verify that wrapping Object.class returns Object.class (non-primitive type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "String[].class"
          }
        ],
        "expected": "String[].class",
        "description": "Test case to verify that wrapping String[].class returns String[].class (array type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "List.class"
          }
        ],
        "expected": "List.class",
        "description": "Test case to verify that wrapping List.class returns List.class (non-primitive type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "Map.class"
          }
        ],
        "expected": "Map.class",
        "description": "Test case to verify that wrapping Map.class returns Map.class (non-primitive type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "int[].class"
          }
        ],
        "expected": "int[].class",
        "description": "Test case to verify that wrapping int[].class returns int[].class (array of primitive type)."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test case to verify that passing null as the type parameter throws a NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "type",
            "value": "Integer.class"
          }
        ],
        "expected": "ClassCastException",
        "description": "Test case to verify that wrapping Integer.class results in a ClassCastException since it is not a primitive type."
      }
    ]
  }
]