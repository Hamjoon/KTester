        "input": [
          {
            "parameter": "context",
            "value": "new Gson()"
          },
          {
            "parameter": "type",
            "value": "TypeToken.get(ClassWithAccessorAndSerializedName.class)"
          },
          {
            "parameter": "raw",
            "value": "ClassWithAccessorAndSerializedName.class"
          },
          {
            "parameter": "blockInaccessible",
            "value": "false"
          },
          {
            "parameter": "isRecord",
