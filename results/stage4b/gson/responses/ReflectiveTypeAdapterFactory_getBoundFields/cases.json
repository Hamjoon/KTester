        "expected": {
          "result": {
            "field1": "BoundField for field1 using accessor",
            "field2": "BoundField for field2 using accessor"
          }
        },
        "description": "Test for a record with accessors for fields, should return BoundFields using the accessor methods."
      }
    ]
  },
