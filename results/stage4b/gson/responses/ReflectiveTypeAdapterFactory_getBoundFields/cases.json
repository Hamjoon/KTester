        "input": [
          {
            "parameter": "context",
            "value": "new Gson()"
          },
          {
            "parameter": "type",
            "value": "TypeToken.get(DerivedClass.class)"
          },
          {
            "parameter": "raw",
            "value": "DerivedClass.class"
          },
          {
            "parameter": "blockInaccessible",
            "value": "false"
          },
          {
