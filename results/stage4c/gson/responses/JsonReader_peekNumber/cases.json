      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": "-9223372036854775809"
          }
        ],
        "expected": "PEEKED_NONE",
        "description": "Test with a number just below Long.MIN_VALUE to ensure it is not recognized as a valid long."
      }
    ]
  }
]