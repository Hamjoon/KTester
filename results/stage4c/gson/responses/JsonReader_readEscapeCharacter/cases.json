[
  {
    "group": "readEscapeCharacter Method Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "t"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\t",
        "description": "Test for tab escape sequence '\\t'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "b"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\b",
        "description": "Test for backspace escape sequence '\\b'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "n"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\n",
        "description": "Test for newline escape sequence '\\n'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "r"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\r",
        "description": "Test for carriage return escape sequence '\\r'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "f"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\f",
        "description": "Test for formfeed escape sequence '\\f'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "0",
              "0",
              "4",
              "1"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 6
          }
        ],
        "expected": "A",
        "description": "Test for unicode escape sequence '\\u0041' which represents 'A'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "0",
              "0",
              "6",
              "1"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 6
          }
        ],
        "expected": "a",
        "description": "Test for unicode escape sequence '\\u0061' which represents 'a'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "'"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "'",
        "description": "Test for single quote escape sequence '\\''"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "\""
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\"",
        "description": "Test for double quote escape sequence '\\\"'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "\\"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "\\",
        "description": "Test for backslash escape sequence '\\\\'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "/"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "/",
        "description": "Test for forward slash escape sequence '\\/'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "x"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "Invalid escape sequence",
        "description": "Test for invalid escape sequence '\\x', expecting syntax error"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 1
          }
        ],
        "expected": "Unterminated escape sequence",
        "description": "Test for unterminated escape sequence due to buffer limit"
      }
    ]
  },
  {
    "group": "readEscapeCharacter Method Additional Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "0",
              "0",
              "G",
              "1"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 6
          }
        ],
        "expected": "Invalid escape sequence",
        "description": "Test for invalid Unicode escape sequence '\\u00G1', expecting NumberFormatException"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "1",
              "2",
              "3"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 5
          }
        ],
        "expected": "Unterminated escape sequence",
        "description": "Test for unterminated Unicode escape sequence '\\u123', expecting syntax error"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "0",
              "0",
              "4",
              "1",
              "A"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 7
          }
        ],
        "expected": "A",
        "description": "Test for valid Unicode escape sequence '\\u0041' followed by an additional character"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "A",
              "B",
              "C",
              "D"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 6
          }
        ],
        "expected": "\u0000ABCD",
        "description": "Test for valid Unicode escape sequence '\\uABCD'"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              " "
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 2
          }
        ],
        "expected": "Invalid escape sequence",
        "description": "Test for invalid escape sequence '\\ ', expecting syntax error"
      }
    ]
  },
  {
    "group": "readEscapeCharacter Method Additional Exception Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 0
          }
        ],
        "expected": "Unterminated escape sequence",
        "description": "Test for unterminated escape sequence due to empty buffer"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "1",
              "2",
              "3",
              "4",
              "5"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 7
          }
        ],
        "expected": "Unterminated escape sequence",
        "description": "Test for invalid Unicode escape sequence with extra characters '\\u12345', expecting syntax error"
      },
      {
        "input": [
          {
            "parameter": "buffer",
            "value": [
              "\\",
              "u",
              "G",
              "H",
              "I",
              "J"
            ]
          },
          {
            "parameter": "pos",
            "value": 0
          },
          {
            "parameter": "limit",
            "value": 6
          }
        ],
        "expected": "Invalid escape sequence",
        "description": "Test for invalid Unicode escape sequence '\\uGHIJ', expecting NumberFormatException"
      }
    ]
  }
]