        "expected": true,
        "description": "Test case where the field has a Since/Until annotation that does not match the current version, which should be excluded."
      },
      {
        "input": [
          {
            "parameter": "field",
            "value": "syntheticField"
          },
          {
            "parameter": "serialize",
            "value": true
