[
  {
    "group": "Flat3Map put(K key, V value) Method Test Cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "key",
            "value": null
          },
          {
            "parameter": "value",
            "value": "value1"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a null key when the map is empty."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": null
          },
          {
            "parameter": "value",
            "value": "value2"
          }
        ],
        "expected": "value1",
        "description": "Update the existing entry with a null key when the map has one entry with a null key."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key1"
          },
          {
            "parameter": "value",
            "value": "value1"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a non-null key when the map is empty."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key1"
          },
          {
            "parameter": "value",
            "value": "value2"
          }
        ],
        "expected": "value1",
        "description": "Update the existing entry with a non-null key when the map has one entry."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key2"
          },
          {
            "parameter": "value",
            "value": "value2"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a different non-null key when the map has one entry."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key2"
          },
          {
            "parameter": "value",
            "value": "value2_updated"
          }
        ],
        "expected": "value2",
        "description": "Update the existing entry with a non-null key when the map has two entries."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key3"
          },
          {
            "parameter": "value",
            "value": "value3"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a different non-null key when the map has two entries."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key3"
          },
          {
            "parameter": "value",
            "value": "value3_updated"
          }
        ],
        "expected": "value3",
        "description": "Update the existing entry with a non-null key when the map has three entries."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key4"
          },
          {
            "parameter": "value",
            "value": "value4"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a different non-null key causing the map to convert to a delegate map."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": null
          },
          {
            "parameter": "value",
            "value": "value_null"
          }
        ],
        "expected": null,
        "description": "Add a new entry with a null key when the map has three entries, causing conversion to a delegate map."
      }
    ]
  },
  {
    "group": "Additional Flat3Map put(K key, V value) Method Test Cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "key",
            "value": "key1"
          },
          {
            "parameter": "value",
            "value": null
          }
        ],
        "expected": "value1",
        "description": "Update an existing entry with a non-null key to have a null value when the map has one entry."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": null
          },
          {
            "parameter": "value",
            "value": null
          }
        ],
        "expected": null,
        "description": "Add a new entry with both a null key and a null value when the map is empty."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key2"
          },
          {
            "parameter": "value",
            "value": null
          }
        ],
        "expected": "value2",
        "description": "Update an existing entry with a non-null key to have a null value when the map has two entries."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key3"
          },
          {
            "parameter": "value",
            "value": null
          }
        ],
        "expected": "value3",
        "description": "Update an existing entry with a non-null key to have a null value when the map has three entries."
      },
      {
        "input": [
          {
            "parameter": "key",
            "value": "key4"
          },
          {
            "parameter": "value",
            "value": null
          }
        ],
        "expected": null,
        "description": "Add a new entry with a non-null key and a null value causing the map to convert to a delegate map."
      }
    ]
  }
]