[
  {
    "group": "getIterator Method Tests",
    "cases": [
      {
        "input": [],
        "expected": "EmptyIterator",
        "description": "Test with null input to return an empty iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new ArrayList<>().iterator()"
          }
        ],
        "expected": "Iterator",
        "description": "Test with an Iterator input to return the same iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new ArrayList<>()"
          }
        ],
        "expected": "Iterator",
        "description": "Test with an Iterable input to return its iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Object[] {1, 2, 3}"
          }
        ],
        "expected": "ObjectArrayIterator",
        "description": "Test with Object array input to return an ObjectArrayIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Vector<>().elements()"
          }
        ],
        "expected": "EnumerationIterator",
        "description": "Test with Enumeration input to return an EnumerationIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new HashMap<>()"
          }
        ],
        "expected": "Iterator",
        "description": "Test with Map input to return an iterator over its values."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "mock(NodeList.class)"
          }
        ],
        "expected": "NodeListIterator",
        "description": "Test with NodeList input to return a NodeListIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "mock(Node.class)"
          }
        ],
        "expected": "NodeListIterator",
        "description": "Test with Node input to return a NodeListIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "mock(Dictionary.class)"
          }
        ],
        "expected": "EnumerationIterator",
        "description": "Test with Dictionary input to return an EnumerationIterator over its elements."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new int[] {1, 2, 3}"
          }
        ],
        "expected": "ArrayIterator",
        "description": "Test with primitive array input to return an ArrayIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new CustomIterable()"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that does not match any condition but has an iterator method to return its iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Object()"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that does not match any condition to return a SingletonIterator."
      }
    ]
  },
  {
    "group": "getIterator Method Additional Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new CustomObjectWithIterator()"
          }
        ],
        "expected": "Iterator",
        "description": "Test with an object that has a public 'iterator' method returning an Iterator, to ensure it returns the correct iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new CustomObjectWithoutIterator()"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that has no 'iterator' method to ensure it returns a SingletonIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Object[0]"
          }
        ],
        "expected": "ObjectArrayIterator",
        "description": "Test with an empty Object array to ensure it returns an ObjectArrayIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new int[0]"
          }
        ],
        "expected": "ArrayIterator",
        "description": "Test with an empty primitive array to ensure it returns an ArrayIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Vector<>()"
          }
        ],
        "expected": "EnumerationIterator",
        "description": "Test with an empty Vector to ensure it returns an EnumerationIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new HashMap<>().entrySet().iterator()"
          }
        ],
        "expected": "Iterator",
        "description": "Test with a Map's entrySet iterator to ensure it returns the same iterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new NodeList()"
          }
        ],
        "expected": "NodeListIterator",
        "description": "Test with an empty NodeList to ensure it returns a NodeListIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Node()"
          }
        ],
        "expected": "NodeListIterator",
        "description": "Test with a single Node to ensure it returns a NodeListIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new CustomIterableWithoutIteratorMethod()"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that implements Iterable but does not have an iterator method to ensure it returns a SingletonIterator."
      }
    ]
  },
  {
    "group": "getIterator Exception Scenarios",
    "cases": [
      {
        "input": [
          {
            "parameter": "obj",
            "value": "new Object()"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that does not match any condition to return a SingletonIterator."
      },
      {
        "input": [
          {
            "parameter": "obj",
            "value": "mock(ObjectWithFaultyIteratorMethod.class)"
          }
        ],
        "expected": "SingletonIterator",
        "description": "Test with an object that has a public 'iterator' method which throws an exception, to ensure it returns a SingletonIterator."
      }
    ]
  }
]