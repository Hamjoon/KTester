[
  {
    "group": "handlePrimitivesInArray",
    "cases": [
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "byte.class"
          },
          {
            "parameter": "value",
            "value": "[1, 2, 3]"
          }
        ],
        "expected": "1, 2, 3",
        "description": "Test with byte array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "short.class"
          },
          {
            "parameter": "value",
            "value": "[10, 20, 30]"
          }
        ],
        "expected": "10, 20, 30",
        "description": "Test with short array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "boolean.class"
          },
          {
            "parameter": "value",
            "value": "[true, false, true]"
          }
        ],
        "expected": "true, false, true",
        "description": "Test with boolean array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "int.class"
          },
          {
            "parameter": "value",
            "value": "[100, 200, 300]"
          }
        ],
        "expected": "100, 200, 300",
        "description": "Test with int array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "long.class"
          },
          {
            "parameter": "value",
            "value": "[1000L, 2000L, 3000L]"
          }
        ],
        "expected": "1000, 2000, 3000",
        "description": "Test with long array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "float.class"
          },
          {
            "parameter": "value",
            "value": "[1.1f, 2.2f, 3.3f]"
          }
        ],
        "expected": "1.1, 2.2, 3.3",
        "description": "Test with float array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "double.class"
          },
          {
            "parameter": "value",
            "value": "[1.11, 2.22, 3.33]"
          }
        ],
        "expected": "1.11, 2.22, 3.33",
        "description": "Test with double array to ensure all elements are correctly converted to string and joined."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "char.class"
          },
          {
            "parameter": "value",
            "value": "['a', 'b', 'c']"
          }
        ],
        "expected": "",
        "description": "Test with unsupported char array to ensure it returns an empty string as char is not handled."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "byte.class"
          },
          {
            "parameter": "value",
            "value": "[]"
          }
        ],
        "expected": "",
        "description": "Test with an empty byte array to ensure it returns an empty string."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "short.class"
          },
          {
            "parameter": "value",
            "value": "[Short.MAX_VALUE, Short.MIN_VALUE]"
          }
        ],
        "expected": "32767, -32768",
        "description": "Test with short array containing boundary values to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "boolean.class"
          },
          {
            "parameter": "value",
            "value": "[]"
          }
        ],
        "expected": "",
        "description": "Test with an empty boolean array to ensure it returns an empty string."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "int.class"
          },
          {
            "parameter": "value",
            "value": "[Integer.MAX_VALUE, Integer.MIN_VALUE]"
          }
        ],
        "expected": "2147483647, -2147483648",
        "description": "Test with int array containing boundary values to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "long.class"
          },
          {
            "parameter": "value",
            "value": "[Long.MAX_VALUE, Long.MIN_VALUE]"
          }
        ],
        "expected": "9223372036854775807, -9223372036854775808",
        "description": "Test with long array containing boundary values to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "float.class"
          },
          {
            "parameter": "value",
            "value": "[Float.MAX_VALUE, Float.MIN_VALUE]"
          }
        ],
        "expected": "3.4028235E38, 1.4E-45",
        "description": "Test with float array containing boundary values to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "double.class"
          },
          {
            "parameter": "value",
            "value": "[Double.MAX_VALUE, Double.MIN_VALUE]"
          }
        ],
        "expected": "1.7976931348623157E308, 4.9E-324",
        "description": "Test with double array containing boundary values to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "int.class"
          },
          {
            "parameter": "value",
            "value": "[0, -0]"
          }
        ],
        "expected": "0, 0",
        "description": "Test with int array containing zero and negative zero to ensure correct conversion and joining."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "byte.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for byte array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "short.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for short array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "boolean.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for boolean array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "int.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for int array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "long.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for long array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "float.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for float array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "double.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for double array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "char.class"
          },
          {
            "parameter": "value",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "Test with null value for unsupported char array to trigger NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "componentType",
            "value": "java.lang.String.class"
          },
          {
            "parameter": "value",
            "value": "['a', 'b', 'c']"
          }
        ],
        "expected": "ClassCastException",
        "description": "Test with unsupported String array to trigger ClassCastException."
      }
    ]
  }
