[
  {
    "group": "resolveExpression Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "expression",
            "value": "simple text"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "simple text",
        "description": "Test with a simple text expression without any curly braces to ensure it returns the same text."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an expression containing an unresolved directive to ensure it throws a RuntimeException."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{name.firstName} #{name.lastName}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved full name",
        "description": "Test with an expression containing valid directives for first and last names to ensure it returns a resolved full name."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{address.city}, #{address.state}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved city and state",
        "description": "Test with an expression containing valid directives for city and state to ensure it returns a resolved city and state."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "Hello, #{name.firstName}!"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Hello, resolved first name!",
        "description": "Test with a mixed expression containing text and a valid directive to ensure it returns the correct resolved text."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{unknown.directive}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an expression containing an unknown directive to ensure it throws a RuntimeException."
      }
    ]
  },
  {
    "group": "resolveExpression Additional Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{name.firstName} #{name.middleName} #{name.lastName}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved full name with middle name",
        "description": "Test with an expression containing valid directives for first, middle, and last names to ensure it returns a resolved full name including the middle name."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{address.streetAddress} #{address.city}, #{address.state} #{address.zipCode}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved full address",
        "description": "Test with an expression containing valid directives for street address, city, state, and zip code to ensure it returns a resolved full address."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "Contact: #{phoneNumber}, Email: #{emailAddress}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved contact information",
        "description": "Test with an expression containing valid directives for phone number and email address to ensure it returns resolved contact information."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{address.city} #{address.unknownField}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an expression containing a valid directive followed by an unknown directive to ensure it throws a RuntimeException."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{name.firstName} #{name.firstName}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "Resolved first name twice",
        "description": "Test with an expression containing the same valid directive repeated to ensure it returns the resolved value twice."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "{}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an empty directive to ensure it throws a RuntimeException."
      }
    ]
  },
  {
    "group": "resolveExpression Edge Case Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive} extra text"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an expression containing an unresolved directive followed by extra text to ensure it throws a RuntimeException."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive1} #{directive2}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an expression containing multiple unresolved directives to ensure it throws a RuntimeException."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": null
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with a null root parameter to ensure it throws a RuntimeException when attempting to resolve a directive."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive}"
          },
          {
            "parameter": "current",
            "value": null
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": null
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with a null context parameter to ensure it throws a RuntimeException when attempting to resolve a directive."
      },
      {
        "input": [
          {
            "parameter": "expression",
            "value": "#{directive}"
          },
          {
            "parameter": "current",
            "value": "invalidCurrentObject"
          },
          {
            "parameter": "root",
            "value": "mockProviderRegistration"
          },
          {
            "parameter": "context",
            "value": "mockFakerContext"
          }
        ],
        "expected": "RuntimeException",
        "description": "Test with an invalid current object to ensure it throws a RuntimeException when attempting to resolve a directive."
      }
    ]
  }
]