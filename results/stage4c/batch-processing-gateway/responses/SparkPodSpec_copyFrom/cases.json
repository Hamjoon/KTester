  {
    "group": "copyFrom Method Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "another",
            "value": {
              "cores": 4,
              "coreLimit": "2000m",
              "memory": "4Gi",
              "memoryOverhead": "500Mi",
              "image": "spark:latest",
              "env": [
                {
                  "name": "ENV_VAR",
                  "value": "value"
                }
              ],
              "labels": {
                "app": "spark"
              },
              "annotations": {
                "annotation1": "value1"
              },
              "terminationGracePeriodSeconds": 30,
              "serviceAccount": "spark-sa",
