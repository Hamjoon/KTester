                {
                  "name": "volume1",
                  "mountPath": "/data"
                }
              ],
              "securityContext": {
                "runAsUser": 1000
              },
              "affinity": {
                "nodeAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": {}
                }
              },
              "coreRequest": "1000m",
              "javaOptions": "-Xmx2g"
            }
          }
        ],
        "expected": "All fields copied correctly",
        "description": "Test copying from a fully populated SparkPodSpec object to a new instance."
