[
  {
    "group": "transcodeRemaining Tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "prev",
            "value": "A"
          },
          {
            "parameter": "curr",
            "value": "E"
          },
          {
            "parameter": "next",
            "value": "V"
          },
          {
            "parameter": "aNext",
            "value": "A"
          }
        ],
        "expected": "['A', 'F']",
        "description": "Test case for EV -> AF transformation."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "A"
          },
          {
            "parameter": "next",
            "value": "C"
          },
          {
            "parameter": "aNext",
            "value": "D"
          }
        ],
        "expected": "['A']",
        "description": "Test case for vowel transformation A -> A."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "Q"
          },
          {
            "parameter": "next",
            "value": "U"
          },
          {
            "parameter": "aNext",
            "value": "E"
          }
        ],
        "expected": "['G']",
        "description": "Test case for Q -> G transformation."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "Z"
          },
          {
            "parameter": "next",
            "value": "O"
          },
          {
            "parameter": "aNext",
            "value": "E"
          }
        ],
        "expected": "['S']",
        "description": "Test case for Z -> S transformation."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "M"
          },
          {
            "parameter": "next",
            "value": "O"
          },
          {
            "parameter": "aNext",
            "value": "E"
          }
        ],
        "expected": "['N']",
        "description": "Test case for M -> N transformation."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "K"
          },
          {
            "parameter": "next",
            "value": "N"
          },
          {
