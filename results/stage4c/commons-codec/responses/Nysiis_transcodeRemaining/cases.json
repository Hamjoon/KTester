      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "O"
          },
          {
            "parameter": "next",
            "value": "U"
          },
          {
            "parameter": "aNext",
            "value": "E"
          }
        ],
        "expected": "['A']",
        "description": "Test case for vowel transformation O -> A."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "B"
          },
          {
            "parameter": "curr",
            "value": "U"
          },
          {
            "parameter": "next",
            "value": "E"
          },
          {
            "parameter": "aNext",
            "value": "I"
          }
        ],
        "expected": "['A']",
        "description": "Test case for vowel transformation U -> A."
      },
      {
        "input": [
          {
            "parameter": "prev",
            "value": "A"
          },
          {
            "parameter": "curr",
            "value": "H"
          },
          {
            "parameter": "next",
