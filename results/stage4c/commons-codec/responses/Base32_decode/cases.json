[
  {
    "group": "Base32 decode method tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "[]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "-1"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.eof = true",
        "description": "Tests handling of negative inAvail, setting context.eof to true."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[61]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "1"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.eof = true",
        "description": "Tests handling of padding character '=', setting context.eof to true."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "1"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.modulus = 1, context.lbitWorkArea = result",
        "description": "Tests valid byte input affecting context.modulus and context.lbitWorkArea."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "8"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "5 bytes decoded and stored in buffer",
        "description": "Tests complete decoding of 8 valid bytes, producing 5 decoded bytes."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "7"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateCharacter(MASK_3BITS, context) called",
        "description": "Tests EOF handling with a modulus of 7, invoking validateCharacter with MASK_3BITS."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "6"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateTrailingCharacters() called",
        "description": "Tests EOF handling with a modulus of 6, invoking validateTrailingCharacters."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "5"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateCharacter(MASK_1BITS, context) called",
        "description": "Tests EOF handling with a modulus of 5, invoking validateCharacter with MASK_1BITS."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "4"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateCharacter(MASK_4BITS, context) called",
        "description": "Tests EOF handling with a modulus of 4, invoking validateCharacter with MASK_4BITS."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "3"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateTrailingCharacters() called",
        "description": "Tests EOF handling with a modulus of 3, invoking validateTrailingCharacters."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "2"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateCharacter(MASK_2BITS, context) called",
        "description": "Tests EOF handling with a modulus of 2, invoking validateCharacter with MASK_2BITS."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "1"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "validateTrailingCharacters() called",
        "description": "Tests EOF handling with a modulus of 1, invoking validateTrailingCharacters."
      }
    ]
  },
  {
    "group": "Base32 decode method additional tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32, 61]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "8"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.eof = true, 5 bytes decoded and stored in buffer",
        "description": "Tests handling of valid input with trailing padding, ensuring correct decoding and EOF setting."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 33, 34, 35, 36, 37, 38, 39]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "8"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.eof = true, exception or partial decoding",
        "description": "Tests handling of invalid characters within the input, expecting exception or partial decoding."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 61, 61, 61, 61, 61, 61]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "8"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "context.eof = true, validateTrailingCharacters() called",
        "description": "Tests input with multiple padding characters to ensure correct EOF and validation handling."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "9"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "5 bytes decoded and stored in buffer, additional byte ignored",
        "description": "Tests handling of input exceeding a full block size, ensuring only valid blocks are decoded."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32, 32, 61]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "9"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "5 bytes decoded and stored in buffer, context.eof = true",
        "description": "Tests handling of valid input block followed by padding, ensuring correct decoding and EOF setting."
      }
    ]
  },
  {
    "group": "Base32 decode method additional exception tests",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "[127]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "1"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "IndexOutOfBoundsException",
        "description": "Tests handling of input byte value out of decode table range, expecting an IndexOutOfBoundsException."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[32, 32, 32, 32, 32, 32, 32, 32]"
          },
          {
            "parameter": "inPos",
            "value": "0"
          },
          {
            "parameter": "inAvail",
            "value": "8"
          },
          {
            "parameter": "context",
            "value": "new Context()"
          }
        ],
        "expected": "IllegalStateException",
        "description": "Tests handling of input causing an impossible modulus state, expecting an IllegalStateException."
      }
    ]
  }
]