      },
      {
        "input": [
          {
            "parameter": "hash",
            "value": "hashCode of 'test'"
          },
          {
            "parameter": "value",
            "value": "test"
          },
          {
            "parameter": "bucket",
            "value": null
          },
          {
            "parameter": "length",
            "value": 0
          }
        ],
        "expected": "NullPointerException",
