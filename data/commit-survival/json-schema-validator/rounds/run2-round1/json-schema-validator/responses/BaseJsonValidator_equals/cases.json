[
  {
    "group": "BaseJsonValidator.equals(double, double) - branch coverage",
    "cases": [
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": 1.0
          }
        ],
        "expected": true,
        "description": "Identical numbers \u2013 difference is 0, which is less than 1e\u201112, so the method should return true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": 1e-13
          }
        ],
        "expected": true,
        "description": "Numbers differ by 9.9e\u201113 (< 1e\u201112); the method should evaluate to true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": 1e-12
          }
        ],
        "expected": false,
        "description": "Numbers differ exactly by 1e\u201112; the strict \u2018<\u2019 comparison fails, so false is expected."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": 1e-11
          }
        ],
        "expected": false,
        "description": "Difference (9e\u201112) exceeds the tolerance; method should return false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": -5.0
          },
          {
            "parameter": "n2",
            "value": -5e-13
          }
        ],
        "expected": true,
        "description": "Negative numbers with a tiny difference (< 1e\u201112) \u2013 should return true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": -5.0
          },
          {
            "parameter": "n2",
            "value": -5e-11
          }
        ],
        "expected": false,
        "description": "Negative numbers whose absolute difference exceeds the tolerance \u2013 should return false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 0.0
          }
        ],
        "expected": true,
        "description": "Both zeros \u2013 difference is zero, therefore true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 1e-13
          }
        ],
        "expected": true,
        "description": "Zero vs a very small positive number (< 1e\u201112) \u2013 true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 1e-12
          }
        ],
        "expected": false,
        "description": "Zero vs a number exactly at the tolerance boundary \u2013 false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "NaN"
          },
          {
            "parameter": "n2",
            "value": 0.0
          }
        ],
        "expected": false,
        "description": "First argument is NaN \u2013 any arithmetic with NaN yields NaN, comparison fails, so false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": "NaN"
          }
        ],
        "expected": false,
        "description": "Second argument is NaN \u2013 same reasoning as above, result false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "Infinity"
          },
          {
            "parameter": "n2",
            "value": "Infinity"
          }
        ],
        "expected": false,
        "description": "Both arguments are positive infinity \u2013 subtraction yields NaN, comparison false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "-Infinity"
          },
          {
            "parameter": "n2",
            "value": "-Infinity"
          }
        ],
        "expected": false,
        "description": "Both arguments are negative infinity \u2013 same behavior as positive infinity, result false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "Infinity"
          },
          {
            "parameter": "n2",
            "value": 1.0
          }
        ],
        "expected": false,
        "description": "One argument infinite, the other finite \u2013 difference is infinite, so false."
      }
    ]
  },
  {
    "group": "BaseJsonValidator.equals(double, double) - additional cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1e-13
          },
          {
            "parameter": "n2",
            "value": -1e-13
          }
        ],
        "expected": true,
        "description": "Positive and negative numbers with a tiny absolute difference (2e-13) that is still below the 1e\u201112 tolerance; should return true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": -1.0
          }
        ],
        "expected": false,
        "description": "Numbers of opposite sign with a large absolute difference (2.0) exceeding the tolerance; should return false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "Infinity"
          },
          {
            "parameter": "n2",
            "value": "-Infinity"
          }
        ],
        "expected": false,
        "description": "Positive infinity versus negative infinity; subtraction yields NaN, comparison fails, so false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "NaN"
          },
          {
            "parameter": "n2",
            "value": "NaN"
          }
        ],
        "expected": false,
        "description": "Both arguments are NaN; any arithmetic with NaN results in NaN, making the '<' comparison false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": -0.0
          }
        ],
        "expected": true,
        "description": "Positive zero versus negative zero; the absolute difference is 0.0, which is less than the tolerance."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.7976931348623157e+308
          },
          {
            "parameter": "n2",
            "value": 1.7976931348623157e+308
          }
        ],
        "expected": true,
        "description": "Two identical maximum double values; subtraction yields 0.0, therefore true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.7976931348623157e+308
          },
          {
            "parameter": "n2",
            "value": 8.988465674311579e+307
          }
        ],
        "expected": false,
        "description": "Maximum double value versus half of it; absolute difference (~8.99e307) far exceeds the tolerance, so false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 2.2250738585072014e-308
          },
          {
            "parameter": "n2",
            "value": 5e-324
          }
        ],
        "expected": true,
        "description": "Two subnormal positive numbers; their absolute difference (~2.225e-308) is far below 1e\u201112, thus true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 2.2250738585072014e-308
          },
          {
            "parameter": "n2",
            "value": 0.0
          }
        ],
        "expected": true,
        "description": "Smallest normal positive double versus zero; difference (~2.2e-308) < tolerance, so true."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 5e-324
          },
          {
            "parameter": "n2",
            "value": 0.0
          }
        ],
        "expected": true,
        "description": "Smallest positive subnormal double versus zero; difference (~4.9e-324) is well under the tolerance, returning true."
      }
    ]
  }
]