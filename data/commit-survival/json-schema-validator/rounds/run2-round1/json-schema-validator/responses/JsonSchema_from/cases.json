            "parameter": "parent",
            "value": "null"
          },
          {
            "parameter": "suppressSubSchemaRetrieval",
            "value": "false"
          }
        ],
        "expected": "NullPointerException",
        "description": "The factory method should reject a null schemaPath because the JSON\u2011Pointer location is required for proper schema identification."
      }
    ]
  },
  {
