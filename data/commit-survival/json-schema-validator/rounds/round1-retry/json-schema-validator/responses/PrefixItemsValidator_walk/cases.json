            "value": "ArrayNode([1,2])"
          },
          {
            "parameter": "at",
            "value": "\"/\""
          },
          {
            "parameter": "shouldValidateSchema",
            "value": "true"
          }
        ],
        "expected": {
          "validationMessages": "empty set",
          "doWalkInvocations": 2,
          "invokedIndices": [
            0,
            1
          ]
        },
        "description": "When the input array has fewer elements than the tupleSchema length, walk must iterate only over the existing elements (i.e., node.size()), invoking doWalk for each index up to node.size()\u20111."
      }
    ]
  },
  {
    "group": "walk_whenNodeSizeGreaterThanTupleSchemaSize_shouldIterateTupleSchemaSizeTimes",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ArrayNode([\"x\",\"y\",\"z\"])"
          },
          {
            "parameter": "rootNode",
            "value": "ArrayNode([\"x\",\"y\",\"z\"])"
          },
          {
            "parameter": "at",
            "value": "\"/\""
          },
          {
            "parameter": "shouldValidateSchema",
            "value": "true"
          }
        ],
        "expected": {
          "validationMessages": "empty set",
          "doWalkInvocations": 2,
          "invokedIndices": [
            0,
            1
          ]
        },
        "description": "If the array contains more items than the tupleSchema, walk must stop at tupleSchema.size() (the minimum of the two lengths), invoking doWalk only for the first tupleSchema.size() indices."
      }
    ]
  },
  {
    "group": "walk_whenElementIsNullAndDefaultExists_shouldReplaceWithDefaultAndPassDefaultToDoWalk",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
